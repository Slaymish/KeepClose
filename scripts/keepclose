#!/bin/zsh
set -euo pipefail
project_root="${0:A:h:h}"
cd "$project_root"
# SwiftPM builds incrementally and prints build diagnostics on stderr.
# --disable-sandbox lets SwiftPM run where a nested sandbox is unavailable.
swift build --product keepclose --disable-sandbox >&2
exec "$project_root/.build/debug/keepclose" "$@"
